# 线上环境
VITE_USER_NODE_ENV = production

# 公共基础路径
VITE_PUBLIC_PATH = /

# 路由模式
# Optional: hash | history
VITE_ROUTER_MODE = history

# 线上环境接口地址
VITE_APP_BASE_API = 'http://localhost:3000'

# ===== Alipay OAuth (PROD) =====
# appId 可直接复用，注意此文件会进构建产物
VITE_ALIPAY_APP_ID = 2021006105637968
VITE_ALIPAY_AUTH_HOST = https://openauth.alipay.com
# 回调地址应指向后端回调接口
VITE_ALIPAY_REDIRECT = https://your-domain.com/api/oauth/alipay/callback