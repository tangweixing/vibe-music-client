# Router mode: 'hash' or 'history'
VITE_ROUTER_MODE=history

# Alipay OAuth config (frontend only)
# Your Alipay app id (non-secret)
VITE_ALIPAY_APP_ID=
# Alipay open auth host. Mainland production is https://openauth.alipay.com
# Sandbox could be https://openauth.alipaydev.com
VITE_ALIPAY_AUTH_HOST=https://openauth.alipay.com
# Optional: Explicit callback URL. If empty, defaults to `${origin}/auth/alipay` (hash mode auto handled)
VITE_ALIPAY_REDIRECT=
