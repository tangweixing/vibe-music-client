# 本地环境
VITE_USER_NODE_ENV = development

# 公共基础路径
VITE_PUBLIC_PATH = /

# 路由模式
# Optional: hash | history
VITE_ROUTER_MODE = history

# 开发环境接口地址
VITE_APP_BASE_API = 'http://localhost:8080'

# 开发环境跨域代理，支持配置多个
VITE_PROXY = [["/api","https://xxxxx"]]
# VITE_PROXY = [["/api","https://www.fastmock.site/mock/xxxxxx"]]
# VITE_PROXY = [["/api-easymock","https://mock.xxxxx.com"],["/api-fastmock","https://www.xxxx"]]

# ===== Alipay OAuth (DEV) =====
# 非敏感：appId 可放前端；私钥/公钥/网关仅用于后端，不要放这里
VITE_ALIPAY_APP_ID = 2021006105637968
# 生产主域： https://openauth.alipay.com ；沙箱用 https://openauth.alipaydev.com
VITE_ALIPAY_AUTH_HOST = https://openauth.alipay.com
# 本地回调地址（如端口不同请修改）
VITE_ALIPAY_REDIRECT = http://sfae89a5.natappfree.cc/api/oauth/alipay/callback